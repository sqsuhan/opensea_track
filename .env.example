# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
# Comma-separated numeric user IDs allowed to run admin commands in DM
TELEGRAM_ADMIN_IDS=123456789

# Data APIs (never commit real keys)
OPENSEA_API_KEY=os_live_your_key
ALCHEMY_API_KEY=your_alchemy_key

# Optional: Moralis is unused when Alchemy is set
MORALIS_API_KEY=

# Polling and signal rules
POLL_INTERVAL_SECONDS=60
SIGNAL_THRESHOLD=2
SIGNAL_WINDOW_HOURS=24
CHAINS=ethereum,base,robinhood,arc,ink

# Filters
MIN_NFT_PRICE_ETH=0.001
MIN_TOKEN_LIQUIDITY_USD=50000

# Paths
DB_PATH=data/signals.db
WALLETS_PATH=wallets.json
LOG_LEVEL=INFO
